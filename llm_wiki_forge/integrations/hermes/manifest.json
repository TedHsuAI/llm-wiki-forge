      },
      {
        "source": "skills/llm-wiki-query/references/android-login-flow.md",
        "target": "skills/llm-wiki-query/references/android-login-flow.md"
      },
      {
        "source": "skills/llm-wiki-query/references/community-path-mismatch.md",
        "target": "skills/llm-wiki-query/references/community-path-mismatch.md"
      },
      {
        "source": "skills/llm-wiki-query/references/events-field-pattern.md",
